{
  "name": "oa-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "lint": "eslint --ext .js,.ts,.vue ./",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.12",
    "axios": "^1.7.7",
    "pinia": "^2.2.4",
    "quasar": "^2.17.0",
    "vue": "^3.5.12",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@quasar/app-vite": "^1.10.0",
    "@types/node": "^22.5.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.28.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "vitest": "^0.34.6",
    "vue-tsc": "^2.1.6"
