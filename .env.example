# 数据库
POSTGRES_USER=oa
POSTGRES_PASSWORD=oa_pass_change_me
POSTGRES_DB=oa_db
POSTGRES_PORT=5432

# 后端
BACKEND_PORT=3000
DATABASE_URL=postgresql://oa:oa_pass_change_me@127.0.0.1:5432/oa_db?schema=public
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:9000
SEED_ADMIN_PASSWORD=change_this_admin_password

# 附件上传目录（容器内路径；主机端通过 oa_uploads volume 持久化）
REIMBURSEMENT_UPLOAD_DIR=/app/uploads/reimbursements
CHANNEL_PUSH_UPLOAD_DIR=/app/uploads/channel-push

# 前端
FRONTEND_PORT=9000
VITE_API_BASE=http://localhost:3000/api/v1
