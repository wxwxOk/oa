// Prisma schema - OA v1.0
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id                                       Int                        @id @default(autoincrement())
  username                                 String                     @unique
  password                                 String
  realName                                 String
  email                                    String?                    @unique
  phone                                    String?
  avatar                                   String?
  status                                   UserStatus                 @default(ACTIVE)
  departmentId                             Int?
  department                               Department?                @relation(fields: [departmentId], references: [id])
  roles                                    UserRole[]
  templates                                FormTemplate[]
  shareLinks                               ShareLink[]
  archiveEvents                            ArchiveEvent[]             @relation("ArchiveEventActor")
  visitRecords                             VisitRecord[]
  reimbursementApplications                ReimbursementApplication[] @relation("ReimbursementApplicant")
  reimbursementAttachments                 ReimbursementAttachment[]  @relation("ReimbursementAttachmentUploader")
  reimbursementActions                     ReimbursementAction[]      @relation("ReimbursementActionActor")
  channelPushesAsPartner                   ChannelPush[]              @relation("ChannelPushPartner")
  channelPushesAsRecipient                 ChannelPush[]              @relation("ChannelPushRecipient")
  channelPushesAsInternalScheduledReceiver ChannelPush[]              @relation("ChannelPushInternalScheduledReceiver")
  channelPushAttachments                   ChannelPushAttachment[]    @relation("ChannelPushAttachmentUploader")
  channelPushReviewActions                 ChannelPushReviewAction[]  @relation("ChannelPushReviewActionActor")
  notifications                            UserNotification[]
  channelPartnerProfile                    ChannelPartnerProfile?     @relation("ChannelPartnerProfileUser")
  channelPartnerProfilesAsRecipient        ChannelPartnerProfile[]    @relation("ChannelPartnerProfileRecipient")
  defaultApproverDepartments               Department[]               @relation("DepartmentDefaultApprover")
  createdAt                                DateTime                   @default(now())
  updatedAt                                DateTime                   @updatedAt

  @@index([departmentId])
}

model Department {
  id                        Int                        @id @default(autoincrement())
  name                      String
  parentId                  Int?
  parent                    Department?                @relation("DeptTree", fields: [parentId], references: [id])
  children                  Department[]               @relation("DeptTree")
  sort                      Int                        @default(0)
  users                     User[]
  defaultApproverId         Int?
  defaultApprover           User?                      @relation("DepartmentDefaultApprover", fields: [defaultApproverId], references: [id])
  reimbursementApplications ReimbursementApplication[] @relation("ReimbursementApplicantDepartment")

  @@index([parentId])
  @@index([defaultApproverId])
}

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  name        String
  description String?
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id     Int              @id @default(autoincrement())
  code   String           @unique
  name   String
  module String
  roles  RolePermission[]

  @@index([module])
}

model UserRole {
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  OFFLINE
}

model FormTemplate {
  id               Int            @id @default(autoincrement())
  name             String
  description      String?
  schema           Json           @default("[]")
  processingSchema Json           @default("[]")
  schemaVersion    Int            @default(1)
  status           TemplateStatus @default(DRAFT)
  requireIdentity  Boolean        @default(false)
  watermarkText    String?        @db.VarChar(50)
  creatorId        Int
  creator          User           @relation(fields: [creatorId], references: [id])
  shareLinks       ShareLink[]
  submissions      Submission[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  @@index([creatorId])
  @@index([status])
  @@index([deletedAt])
}

enum ArchiveSourceType {
  COLLECTION
}

enum ArchiveEventType {
  TAGS_UPDATED
  NOTE_ADDED
  CONTROLLED_EDIT
  PROCESSING_UPDATED
}

enum ReimbursementStatus {
  DRAFT
  DEPARTMENT_REVIEW
  FINANCE_REVIEW
  APPROVED
  REJECTED
}

enum ReimbursementActionType {
  SUBMIT
  DEPARTMENT_APPROVE
  DEPARTMENT_REJECT
  FINANCE_APPROVE
  FINANCE_REJECT
}

enum ChannelPushStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ChannelPushReviewActionType {
  SUBMIT
  EDIT
  CANCEL
  APPROVE
  REJECT
}

enum UserNotificationType {
  CHANNEL_PUSH_PENDING_REVIEW
  CHANNEL_PUSH_REVIEWED
}

model ArchiveRecordMeta {
  id             Int               @id @default(autoincrement())
  sourceType     ArchiveSourceType
  submissionId   Int?              @unique
  submission     Submission?       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  tags           String[]          @default([])
  processingData Json              @default("{}")
  correctionData Json              @default("{}")
  events         ArchiveEvent[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([sourceType])
  @@index([sourceType, submissionId])
  @@index([updatedAt])
}

model ArchiveEvent {
  id           Int               @id @default(autoincrement())
  metadataId   Int
  metadata     ArchiveRecordMeta @relation(fields: [metadataId], references: [id], onDelete: Cascade)
  sourceType   ArchiveSourceType
  submissionId Int?
  submission   Submission?       @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  actorId      Int?
  actor        User?             @relation("ArchiveEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName    String
  type         ArchiveEventType
  reason       String?
  comment      String?
  payload      Json?
  createdAt    DateTime          @default(now())

  @@index([metadataId, createdAt])
  @@index([sourceType, createdAt])
  @@index([submissionId, createdAt])
  @@index([actorId])
  @@index([type])
}

model ShareLink {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  templateId  Int
  template    FormTemplate @relation(fields: [templateId], references: [id])
  creatorId   Int
  creator     User         @relation(fields: [creatorId], references: [id])
  createdAt   DateTime     @default(now())
  submissions Submission[]

  @@index([templateId])
  @@index([creatorId])
}

model Submission {
  id             Int                @id @default(autoincrement())
  data           Json
  schemaVersion  Int
  submitterName  String?
  submitterPhone String?
  templateId     Int
  template       FormTemplate       @relation(fields: [templateId], references: [id])
  shareLinkId    Int
  shareLink      ShareLink          @relation(fields: [shareLinkId], references: [id])
  archiveMeta    ArchiveRecordMeta?
  archiveEvents  ArchiveEvent[]
  createdAt      DateTime           @default(now())

  @@index([templateId])
  @@index([shareLinkId])
  @@index([createdAt])
}

model ReimbursementApplication {
  id                      Int                       @id @default(autoincrement())
  applicationNo           String                    @unique
  title                   String
  category                String
  occurredAt              DateTime
  amount                  Decimal                   @db.Decimal(12, 2)
  reason                  String
  payeeInfo               String?
  remark                  String?
  status                  ReimbursementStatus       @default(DRAFT)
  applicantId             Int
  applicant               User                      @relation("ReimbursementApplicant", fields: [applicantId], references: [id])
  applicantName           String
  applicantDepartmentId   Int?
  applicantDepartment     Department?               @relation("ReimbursementApplicantDepartment", fields: [applicantDepartmentId], references: [id])
  applicantDepartmentName String?
  submittedAt             DateTime?
  completedAt             DateTime?
  attachments             ReimbursementAttachment[]
  actions                 ReimbursementAction[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([applicantId])
  @@index([applicantDepartmentId])
  @@index([status])
  @@index([category])
  @@index([occurredAt])
  @@index([createdAt])
}

model ReimbursementAttachment {
  id            Int                      @id @default(autoincrement())
  applicationId Int
  application   ReimbursementApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  originalName  String
  storedName    String
  relativePath  String
  mimeType      String
  size          Int
  uploaderId    Int
  uploader      User                     @relation("ReimbursementAttachmentUploader", fields: [uploaderId], references: [id])
  createdAt     DateTime                 @default(now())

  @@index([applicationId])
  @@index([uploaderId])
}

model ReimbursementAction {
  id                    Int                      @id @default(autoincrement())
  applicationId         Int
  application           ReimbursementApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId               Int
  actor                 User                     @relation("ReimbursementActionActor", fields: [actorId], references: [id])
  actorName             String
  type                  ReimbursementActionType
  nodeName              String?
  comment               String?
  signatureRelativePath String?
  signatureMimeType     String?
  signatureSize         Int?
  createdAt             DateTime                 @default(now())

  @@index([applicationId])
  @@index([actorId])
  @@index([type])
  @@index([createdAt])
}

model VisitRecord {
  id                 Int       @id @default(autoincrement())
  name               String
  age                Int?
  education          String?
  gender             String?
  channelPartner     String?
  consultant         String?
  receptionStatus    String?
  receptionist       String?
  receptionDate      DateTime?
  consultationStatus String?
  statusCategory     String?
  statusDescription  String?
  trialStatus        String?
  solution           String?
  trialDate          DateTime?
  creatorId          Int
  creator            User      @relation(fields: [creatorId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([name])
  @@index([channelPartner])
  @@index([consultant])
  @@index([receptionist])
  @@index([receptionStatus])
  @@index([receptionDate])
  @@index([consultationStatus])
  @@index([statusCategory])
  @@index([creatorId])
}

model ChannelPush {
  id                          Int                       @id @default(autoincrement())
  channelPartnerId            Int
  channelPartner              User                      @relation("ChannelPushPartner", fields: [channelPartnerId], references: [id])
  recipientUserId             Int
  recipient                   User                      @relation("ChannelPushRecipient", fields: [recipientUserId], references: [id])
  studentName                 String
  studentPhone                String
  studentAge                  Int?
  studentEducation            String?
  studentGender               String?
  intentStatus                String?
  intentNote                  String?
  remark                      String?
  status                      ChannelPushStatus         @default(PENDING)
  submittedAt                 DateTime                  @default(now())
  lastEditedAt                DateTime?
  cancelledAt                 DateTime?
  internalScheduledReceiverId Int?
  internalScheduledReceiver   User?                     @relation("ChannelPushInternalScheduledReceiver", fields: [internalScheduledReceiverId], references: [id])
  internalScheduledDate       DateTime?
  internalNote                String?
  attachments                 ChannelPushAttachment[]
  reviewActions               ChannelPushReviewAction[]
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  @@index([channelPartnerId, status])
  @@index([recipientUserId, status])
  @@index([studentName, studentPhone])
  @@index([status])
  @@index([submittedAt])
}

model ChannelPushAttachment {
  id            Int         @id @default(autoincrement())
  channelPushId Int
  channelPush   ChannelPush @relation(fields: [channelPushId], references: [id], onDelete: Cascade)
  originalName  String
  storedName    String
  relativePath  String
  mimeType      String
  size          Int
  uploaderId    Int
  uploader      User        @relation("ChannelPushAttachmentUploader", fields: [uploaderId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([channelPushId])
  @@index([uploaderId])
}

model ChannelPushReviewAction {
  id            Int                         @id @default(autoincrement())
  channelPushId Int
  channelPush   ChannelPush                 @relation(fields: [channelPushId], references: [id], onDelete: Cascade)
  actorId       Int
  actor         User                        @relation("ChannelPushReviewActionActor", fields: [actorId], references: [id])
  actorName     String
  type          ChannelPushReviewActionType
  comment       String?
  createdAt     DateTime                    @default(now())

  @@index([channelPushId])
  @@index([actorId])
  @@index([type])
  @@index([createdAt])
}

model ChannelPartnerProfile {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  user               User     @relation("ChannelPartnerProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  primaryRecipientId Int
  primaryRecipient   User     @relation("ChannelPartnerProfileRecipient", fields: [primaryRecipientId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([primaryRecipientId])
}

model UserNotification {
  id          Int                  @id @default(autoincrement())
  userId      Int
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        UserNotificationType
  title       String
  summary     String?
  targetRoute String
  sourceType  String
  sourceId    Int
  readAt      DateTime?
  createdAt   DateTime             @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
}
